{
  "name": "@local/dynamic-memory",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Durable long-term memory for DeepSeek Harness: evidence-layer observations, portrait versions with own sources, layered injection with disclosure policy, consolidation drafts, calibrated retrieval confidence and recycle bin",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/qixidalao/dsh-plugin.git"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "cordis-plugin",
    "long-term-memory",
    "memory"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "DOCS.md",
    "CHANGELOG.md",
    "eval.mjs",
    "eval-queries.fixture.json",
    "test.mjs",
    "test-host.mjs",
    "bench.mjs",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test.mjs",
    "test:host": "node test-host.mjs",
    "eval": "node eval.mjs --fixture"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
